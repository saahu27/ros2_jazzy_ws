<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>puma560_cpp</name>
  <version>1.0.0</version>
  <description>C++ implementation of Puma560 motion controllers with trapezoidal velocity profiles</description>
  <maintainer email="sahruday@example.com">Sahruday Patti</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  
  <!-- Message dependencies -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>builtin_interfaces</depend>
  
  <!-- MoveIt dependencies -->
  <depend>moveit_msgs</depend>
  
  <!-- Math library -->
  <depend>eigen</depend>
  
  <!-- Launch dependencies -->
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>puma560_description</exec_depend>
  
  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

