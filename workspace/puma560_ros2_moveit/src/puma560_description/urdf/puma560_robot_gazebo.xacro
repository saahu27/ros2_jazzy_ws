<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arduinobot">

  <!-- Configurable parameters for different control modes -->
  <!-- position_gain: Low (10.0) for compliance control, High (1000.0) for trapezoidal tracking -->
  <!-- controller_config: "controller_compliance.yaml" for compliance, "controller_trapezoidal.yaml" for tracking -->
  <xacro:arg name="position_gain" default="10.0"/>
  <xacro:arg name="controller_config" default="controller.yaml"/>

  <!-- ROS 2 Control -->
  <gazebo>
    <!-- ROS 2 Humble -->
    <xacro:if value="$(arg is_ignition)">
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(find puma560_description)/config/$(arg controller_config)</parameters>
        <!-- Configurable position proportional gain -->
        <!-- Low gain (10.0) for compliance, High gain (1000.0) for trapezoidal tracking -->
        <position_proportional_gain>$(arg position_gain)</position_proportional_gain>
      </plugin>
    </xacro:if>

    <!-- ROS 2 Iron or above -->
    <xacro:unless value="$(arg is_ignition)">
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find puma560_description)/config/$(arg controller_config)</parameters>
        <!-- Configurable position proportional gain -->
        <!-- Low gain (10.0) for compliance, High gain (1000.0) for trapezoidal tracking -->
        <position_proportional_gain>$(arg position_gain)</position_proportional_gain>
      </plugin>
    </xacro:unless>
  </gazebo>

  <!-- Gazebo joint physics settings for lift_joint -->
  <gazebo reference="lift_joint">
    <provideFeedback>true</provideFeedback>
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>

  <!-- ========== LIFT MECHANISM COLLISION SETTINGS ========== -->
  <!-- Lift column (fixed structure) - no collision to allow lift movement -->
  <gazebo reference="lift_column_link">
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- Lift platform (moving carriage) -->
  <gazebo reference="lift_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- ========== ARM LINKS COLLISION SETTINGS ========== -->
  <!-- Disable self-collision for all arm links to prevent internal collisions -->
  <gazebo reference="link1">
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link2">
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link3">
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link4">
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link5">
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link6">
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link7">
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- ========== FORCE/TORQUE SENSOR ========== -->
  <!-- FT sensor at wrist joint (j6) for compliance control -->
  <!-- Measures forces/torques between link6 and link7 (end-effector) -->
  <!-- Note: Requires ignition-gazebo-forcetorque-system plugin in world file -->
  <gazebo reference="j6">
    <sensor name="ft_sensor" type="force_torque">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>ft_sensor</topic>
      <force_torque>
        <!-- Frame: child = link7 (end-effector) -->
        <frame>child</frame>
        <!-- Measure direction: forces exerted ON the child link -->
        <measure_direction>child_to_parent</measure_direction>
      </force_torque>
    </sensor>
  </gazebo>

</robot>